<Page x:Class="CS2D_ModHub.Pages.ComPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ComPage">
 <Grid Margin="38,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="СООБЩЕСТВО" Style="{StaticResource Heading}"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Border Background="#151F40" BorderBrush="#354364" BorderThickness="1" Margin="0,20,0,15" Padding="25" MaxWidth="730" HorizontalAlignment="Left" Width="650"><StackPanel><TextBlock Text="ОБРАТНАЯ СВЯЗЬ" Foreground="Yellow" FontSize="17" FontWeight="Bold"/><TextBlock Text="Выбери тип обращения и заполни поля. Отправка имитируется." Foreground="#A6B0C6" Margin="0,10,0,19" TextWrapping="Wrap"/><TextBlock Text="Тип обращения" Foreground="White" Margin="0,0,0,7"/><ComboBox x:Name="TypeBox" SelectedIndex="0" Height="36" Margin="0,0,0,14"><ComboBoxItem Content="Отзыв о приложении"/><ComboBoxItem Content="Обращение в поддержку"/></ComboBox><TextBlock Text="Имя" Foreground="White" Margin="0,0,0,6"/><TextBox x:Name="NameBox" MaxLength="80" Margin="0,0,0,14"/><TextBlock Text="Email" Foreground="White" Margin="0,0,0,6"/><TextBox x:Name="EmailBox" MaxLength="120" Margin="0,0,0,14"/><TextBlock Text="Текст обращения" Foreground="White" Margin="0,0,0,6"/><TextBox x:Name="MessageBoxInput" AcceptsReturn="True" Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="1200" Margin="0,0,0,20"/><Button Content="Отправить (демо)" Style="{StaticResource AccentButton}" Width="210" HorizontalAlignment="Left" Click="Send_Click"/><TextBlock Text="Данные никуда не передаются и не сохраняются." Foreground="#A6B0C6" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border></ScrollViewer><Button Grid.Row="2" Content="←  На главную" Width="170" HorizontalAlignment="Left" Click="Home_Click"/></Grid>
</Page>
