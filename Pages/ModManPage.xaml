<Page x:Class="CS2D_ModHub.Pages.ModManPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ModManPage">
 <Grid Margin="36,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button Content="←  Вернуться к списку" Click="Back_Click" DockPanel.Dock="Left" Width="215" HorizontalAlignment="Left"/><TextBlock Text="КАРТОЧКА МОДИФИКАЦИИ" Style="{StaticResource Subtle}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#111B38" BorderBrush="#4B5F80" BorderThickness="1" Height="280" VerticalAlignment="Top"><Grid><TextBlock x:Name="CoverLetters" FontFamily="Impact" FontSize="65" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="CS2D MOD" FontSize="12" Foreground="#8093B2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"/></Grid></Border>
   <StackPanel Grid.Column="1" Margin="30,6,0,0"><TextBlock x:Name="TitleText" FontSize="33" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/><TextBlock x:Name="BadgeText" Foreground="Yellow" FontWeight="Bold" FontSize="12" Margin="0,12,0,17"/><Border Background="#283653" Height="1" Margin="0,0,0,18"/><TextBlock x:Name="VersionText" FontSize="15" Foreground="#C5D2E4" Margin="0,0,0,9"/><TextBlock x:Name="AuthorText" FontSize="15" Foreground="#C5D2E4" Margin="0,0,0,9"/><TextBlock x:Name="CategoryText" FontSize="15" Foreground="#C5D2E4" Margin="0,0,0,24"/><TextBlock Text="ОПИСАНИЕ" Foreground="Yellow" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock x:Name="DescriptionText" Foreground="#E5EAF4" FontSize="15" TextWrapping="Wrap" LineHeight="23"/><Button Content="Скачать мод" Style="{StaticResource AccentButton}" Click="Download_Click" Margin="0,28,0,0" Width="195" HorizontalAlignment="Left"/></StackPanel>
  </Grid>
    </Grid>
</Page>
