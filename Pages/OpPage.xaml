<Page x:Class="CS2D_ModHub.Pages.OpPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpPage">
 <Grid Margin="38,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="НАСТРОЙКИ" Style="{StaticResource Heading}"/><Border Grid.Row="1" Background="#151F40" BorderBrush="#354364" BorderThickness="1" Padding="28" VerticalAlignment="Top" Margin="0,24,0,0"><StackPanel><TextBlock Text="ОТОБРАЖЕНИЕ МОДОВ" Foreground="Yellow" FontSize="15" FontWeight="Bold" Margin="0,0,0,23"/><CheckBox x:Name="AlphaCheck" Content="Показывать альфа-версии модов" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Включает в список экспериментальные версии с пометкой ALPHA." Style="{StaticResource Subtle}" Margin="22,-12,0,25"/><CheckBox x:Name="UnverifiedCheck" Content="Показывать непроверенные моды" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Отображает записи без отметки проверки." Style="{StaticResource Subtle}" Margin="22,-12,0,26"/><Border Background="#283653" Height="1"/><TextBlock Text="Настройки сразу влияют на список. После перезапуска программы они сбрасываются." Foreground="#ACB8CE" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border><Button Grid.Row="2" Content="←  На главную" Width="170" HorizontalAlignment="Left" Click="Home_Click"/></Grid>
</Page>
