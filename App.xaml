<Application x:Class="CS2D_ModHub.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0F1839"/>
    <SolidColorBrush x:Key="Panel" Color="#151F40"/>
    <SolidColorBrush x:Key="Panel2" Color="#1D2A4F"/>
    <SolidColorBrush x:Key="Line" Color="#354364"/>
    <SolidColorBrush x:Key="Gold" Color="#FFFF00"/>
    <SolidColorBrush x:Key="Muted" Color="#A6B0C6"/>
    <Style TargetType="Page"><Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="#EEEEF4"/><Setter Property="FontFamily" Value="Arial"/></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="Arial"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#F0F3FA"/><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="edge" Property="BorderBrush" Value="Yellow"/><Setter TargetName="edge" Property="Background" Value="#293D6A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="edge" Property="Background" Value="#3A4A22"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#101728"/><Setter Property="Background" Value="#EEEE00"/><Setter Property="BorderBrush" Value="#FFFF66"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0A1229"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="Yellow"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5EAF4"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,0,0,17"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="25"/></Style>
    <Style x:Key="Subtle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/></Style>
  </Application.Resources>
</Application>
